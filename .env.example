# 复制本文件为 .env 并填写真实值（不要提交 .env）

# DashScope（qwen3.5-plus）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 原生 DashScope（ChatTongyi、DashScopeEmbeddings SDK）；勿与上一行混用同一地址
DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Tavily
TAVILY_API_KEY=

# AgentUser gRPC（供 server 调用，默认 50052；与 FastAPI 同进程由 app.main 拉起）
PRIVATE_CHEF_AGENT_USER_GRPC_PORT=50052
# 仅起 HTTP、不绑定 gRPC 端口时设为 1
# DISABLE_AGENT_USER_GRPC=1
